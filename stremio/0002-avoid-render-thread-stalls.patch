+//! Stack-allocated render parameters, including skipped hidden-window frames.
+use libmpv2::{Error, Mpv, Result};
+use libmpv2_sys as ffi;
+use std::{ffi::{CStr, c_void}, ptr::{self, NonNull}};
+
+type UpdateCallback = Box<dyn Fn() + Send>;
+
+pub struct Renderer {
+    context: NonNull<ffi::mpv_render_context>,
+    // Double boxing gives the C callback a stable, thin pointer.
+    callback: Option<Box<UpdateCallback>>,
+}
+
+unsafe extern "C" fn get_proc_address(_: *mut c_void, name: *const std::ffi::c_char) -> *mut c_void {
+    let Ok(name) = (unsafe { CStr::from_ptr(name) }).to_str() else {
+        return ptr::null_mut();
+    };
+    epoxy::get_proc_addr(name) as _
+}
+
+unsafe extern "C" fn update_callback(data: *mut c_void) {
+    let callback = unsafe { &*(data as *const UpdateCallback) };
+    callback();
+}
+
+fn check(status: i32) -> Result<()> {
+    if status < 0 { Err(Error::Raw(status)) } else { Ok(()) }
+}
+
+fn param(type_: u32, data: *mut c_void) -> ffi::mpv_render_param {
+    ffi::mpv_render_param { type_, data }
+}
+
+impl Renderer {
+    pub fn new(mpv: &Mpv, wayland_display: Option<*mut c_void>) -> Result<Self> {
+        let mut init = ffi::mpv_opengl_init_params {
+            get_proc_address: Some(get_proc_address),
+            get_proc_address_ctx: ptr::null_mut(),
+        };
+        let mut params = vec![
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_API_TYPE, c"opengl".as_ptr() as _),
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, &mut init as *mut _ as _),
+        ];
+        if let Some(display) = wayland_display {
+            params.push(param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_WL_DISPLAY, display));
+        }
+        params.push(param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_INVALID, ptr::null_mut()));
+        let mut context = ptr::null_mut();
+        check(unsafe {
+            ffi::mpv_render_context_create(&mut context, mpv.ctx.as_ptr(), params.as_mut_ptr())
+        })?;
+        Ok(Self { context: NonNull::new(context).ok_or(Error::Null)?, callback: None })
+    }
+
+    pub fn set_update_callback(&mut self, callback: impl Fn() + Send + 'static) {
+        let mut callback: Box<UpdateCallback> = Box::new(Box::new(callback));
+        unsafe {
+            ffi::mpv_render_context_set_update_callback(
+                self.context.as_ptr(), Some(update_callback), &mut *callback as *mut _ as _,
+            );
+        }
+        self.callback = Some(callback);
+    }
+
+    pub fn update(&self) {
+        unsafe { ffi::mpv_render_context_update(self.context.as_ptr()); }
+    }
+
+    pub fn render(&self, fbo: i32, width: i32, height: i32, skip: bool) -> Result<()> {
+        let mut target = ffi::mpv_opengl_fbo { fbo, w: width, h: height, internal_format: 0 };
+        let mut flip: i32 = 1;
+        let mut skip: i32 = skip.into();
+        // The shell uses video-timing-offset=0. Do not wait on video timing
+        // inside the GTK main loop, including when acknowledging hidden frames.
+        let mut block: i32 = 0;
+        let mut params = [
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_OPENGL_FBO, &mut target as *mut _ as _),
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_FLIP_Y, &mut flip as *mut _ as _),
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_SKIP_RENDERING, &mut skip as *mut _ as _),
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_BLOCK_FOR_TARGET_TIME, &mut block as *mut _ as _),
+            param(ffi::mpv_render_param_type_MPV_RENDER_PARAM_INVALID, ptr::null_mut()),
+        ];
+        check(unsafe { ffi::mpv_render_context_render(self.context.as_ptr(), params.as_mut_ptr()) })
+    }
+}
+
+impl Drop for Renderer {
+    fn drop(&mut self) {
+        // Stop callbacks while their storage is still alive. The caller makes
+        // the GL context current before dropping this renderer.
+        unsafe {
+            ffi::mpv_render_context_set_update_callback(self.context.as_ptr(), None, ptr::null_mut());
+            ffi::mpv_render_context_free(self.context.as_ptr());
+        }
+    }
+}
