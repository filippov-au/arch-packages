+//! Nonblocking libmpv calls for the GTK/render thread.
+use libmpv2::{Error, Format, Mpv, Result, SetData, mpv_format};
+use std::{ffi::CString, ptr};
+
+fn check(status: i32) -> Result<()> {
+    if status < 0 { Err(Error::Raw(status)) } else { Ok(()) }
+}
+
+pub fn command(mpv: &Mpv, name: &str, args: &[&str]) -> Result<()> {
+    let strings = std::iter::once(name)
+        .chain(args.iter().copied())
+        .map(CString::new)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    let mut pointers: Vec<_> = strings.iter().map(|s| s.as_ptr()).collect();
+    pointers.push(ptr::null());
+    // libmpv copies the arguments before returning. Completion/errors arrive
+    // through the event queue of the given client, without blocking GTK drawing.
+    check(unsafe {
+        libmpv2_sys::mpv_command_async(mpv.ctx.as_ptr(), 0, pointers.as_mut_ptr())
+    })
+}
+
+pub fn set_property<T: SetData>(mpv: &Mpv, name: &str, value: T) -> Result<()> {
+    let name = CString::new(name)?;
+    let format = match T::get_format() {
+        Format::String => mpv_format::String,
+        Format::Flag => mpv_format::Flag,
+        Format::Int64 => mpv_format::Int64,
+        Format::Double => mpv_format::Double,
+        Format::Node => mpv_format::Node,
+    };
+    value.call_as_c_void(|data| {
+        // libmpv copies the value, including string data, during this call.
+        check(unsafe {
+            libmpv2_sys::mpv_set_property_async(mpv.ctx.as_ptr(), 0, name.as_ptr(), format, data)
+        })
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use libmpv2::events::Event;
+
+    fn player() -> Mpv {
+        Mpv::with_initializer(|init| {
+            init.set_property("vo", "null")?;
+            init.set_property("ao", "null")?;
+            Ok(())
+        }).unwrap()
+    }
+
+    #[test]
+    fn queued_string_property_outlives_its_argument() {
+        let mpv = player();
+        set_property(&mpv, "force-media-title", String::from("queued title")).unwrap();
+        for _ in 0..10 {
+            match mpv.wait_event(0.5) {
+                Some(Ok(Event::SetPropertyReply(0))) => {
+                    assert_eq!(mpv.get_property::<String>("force-media-title").unwrap(), "queued title");
+                    return;
+                }
+                Some(Err(e)) => panic!("Async property failed: {e}"),
+                _ => {}
+            }
+        }
+        panic!("No async property completion");
+    }
+
+    #[test]
+    fn queued_command_outlives_its_arguments() {
+        let mpv = player();
+        {
+            let argument = String::from("17");
+            command(&mpv, "set", &["volume", &argument]).unwrap();
+        }
+        for _ in 0..10 {
+            match mpv.wait_event(0.5) {
+                Some(Ok(Event::CommandReply(0))) => {
+                    assert_eq!(mpv.get_property::<f64>("volume").unwrap(), 17.0);
+                    return;
+                }
+                Some(Err(e)) => panic!("Async command failed: {e}"),
+                _ => {}
+            }
+        }
+        panic!("No async command completion");
+    }
+}
